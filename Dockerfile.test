ARG PYTHON_IMAGE=python:3.13.7-slim-bookworm@sha256:adafcc17694d715c905b4c7bebd96907a1fd5cf183395f0ebc4d3428bd22d92d
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLATFORMIO_CORE_DIR=/opt/platformio \
    PLATFORMIO_SETTING_ENABLE_TELEMETRY=no

RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY server/requirements.txt server/requirements-dev.txt /tmp/requirements/
RUN python -m pip install --no-cache-dir \
      --requirement /tmp/requirements/requirements-dev.txt \
      platformio==6.2.0

RUN useradd --create-home --uid 10001 tester \
    && install --directory --owner=tester --group=tester /opt/platformio /workspace

WORKDIR /workspace
COPY --chown=tester:tester platformio.ini ./
COPY --chown=tester:tester firmware ./firmware
COPY --chown=tester:tester server/pytest.ini ./server/pytest.ini
COPY --chown=tester:tester server/src ./server/src
COPY --chown=tester:tester server/tests ./server/tests
COPY --chown=tester:tester tests ./tests

USER tester

# Resolve the native platform while building so test execution needs no network.
RUN platformio pkg install --environment native

CMD ["sh", "-c", "python -m pytest server/tests -q && platformio test -e native"]
